{
  "name": "lyricflow",
  "version": "1.1.0",
  "description": "LyricFlow - synced lyrics for whatever your desktop player is playing",
  "main": "main.js",
  "author": "LyricFlow",
  "license": "GPL-3.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "test:smoke": "node tools/smoke-test.js",
    "test:gui": "electron tools/electron-smoke.js",
    "dist": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.lyricflow.app",
    "productName": "LyricFlow",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "gui.html",
      "server.js",
      "index.html",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "LyricFlow.exe"
    },
    "nsis": {
      "artifactName": "LyricFlow-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "node-forge": "^1.3.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  }
}